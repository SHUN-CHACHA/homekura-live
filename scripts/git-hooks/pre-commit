#!/bin/sh
# コミットのたびに index.html のキャッシュ対策用バージョン番号（?v=...）を更新する。
# 有効化（このPCで1回だけ）：git config core.hooksPath scripts/git-hooks

# scripts/ だけの変更ならサイトの見た目は変わらないので何もしない
if [ -z "$(git diff --cached --name-only | grep -v '^scripts/')" ]; then
    exit 0
fi

root="$(git rev-parse --show-toplevel)"
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/bump-asset-version.ps1" || exit 1
git add "$root/index.html"
