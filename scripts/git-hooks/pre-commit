#!/bin/sh
# コミットのたびに、サイト内のすべての HTML ページのキャッシュ対策用バージョン番号（?v=...）を更新する。
# 書き換えたページはスクリプト側（-Stage）でコミットに含める。
# 有効化（このPCで1回だけ）：git config core.hooksPath scripts/git-hooks

# scripts/ だけの変更ならサイトの見た目は変わらないので何もしない
if [ -z "$(git diff --cached --name-only | grep -v '^scripts/')" ]; then
    exit 0
fi

root="$(git rev-parse --show-toplevel)"
powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$root/scripts/bump-asset-version.ps1" -Stage || exit 1
